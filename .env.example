# 复制本文件为 .env（项目根目录）后填写。
# .env 已被 .gitignore 忽略，不会进入版本库；进程环境变量优先于 .env。
#
# ── 必需项：缺失时后端启动会直接报错退出（不提供任何内置默认值）──
JWT_SECRET_KEY=
SUPER_ADMIN_PASSWORD=
DEFAULT_COMPANY_DB_PASSWORD=

# ── 可选项：留空则使用以下默认值 ──
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@example.com
DEFAULT_COMPANY_NAME=我的公司
ACCESS_TOKEN_EXPIRE_MINUTES=720
