# ============================================================
# 69码查询器 - FastAPI 后端 systemd 服务
# 部署位置: /etc/systemd/system/69code-query.service
#
# 说明：
#   - 单 worker 运行，固定 --workers 1
#   - 以 www-data 用户运行，便于读写 /opt/69code-query/data/
# ============================================================

[Unit]
Description=69 Code Query FastAPI Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data

# 后端工作目录（main.py 所在目录）
WorkingDirectory=/opt/69code-query/backend

# 启动命令：监听 127.0.0.1:8006，仅内网由 Nginx 反代
ExecStart=/opt/69code-query/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8006 --workers 1

Restart=always
RestartSec=3

Environment=PYTHONUNBUFFERED=1

# 生产环境密钥：从服务器本地 /opt/69code-query/.env 读取 JWT_SECRET_KEY
# （.env 不入库，避免公开仓库泄露密钥；文件不存在时忽略，使用代码内默认值）
EnvironmentFile=-/opt/69code-query/.env

# 上传/输出文件较多时提高文件描述符上限
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
